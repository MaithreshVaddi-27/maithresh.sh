# Cloudflare Pages / Netlify edge-cache rules.
# Versioned (?v=) CSS/JS/assets are content-addressed by query string,
# so they are safe to cache immutably for a year. HTML stays short-lived
# so content edits propagate immediately (GitHub Pages ignores this file
# harmlessly — it activates on Cloudflare Pages / Netlify, see netlify.toml).

/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
