# Cloudflare Pages edge-cache rules. Vite emits content-hashed files into
# /assets/* (CSS, JS, images), so they are safe to cache immutably for a year
# and a deploy only busts the cache for files whose hash actually changed.
# index.html is left at the Pages default (no-cache) so content edits
# propagate immediately.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
