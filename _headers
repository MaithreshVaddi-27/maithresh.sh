# Cloudflare Pages edge-cache rules. Versioned (?v=) CSS/JS/assets are
# content-addressed by query string, so they are safe to cache immutably for
# a year. HTML is left at the Pages default (no-cache) so content edits
# propagate immediately.

/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
