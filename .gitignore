# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Deps
node_modules/
.wrangler/
*.log

# Build output (rebuilt by `npm run build`, deployed from dist/)
dist/

# Local browser-automation scratch
.playwright-cli/
output/playwright/

# Internal tooling — never deploy, and never tracked
.superpowers/
.claude/
# Local agent/tool session state. This was only in .git/info/exclude, which is
# local to one clone — a fresh clone or a collaborator would see it as untracked
# noise. Anything that should be ignored for everyone belongs here.
.freebuff/

# Test scratch (ad-hoc local files only — the tracked tests/ suite always ships)
test_*.md
test_*.txt
*.tmp
*.bak
