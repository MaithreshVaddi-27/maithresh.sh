{
  "name": "maithresh-sh",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "maithresh.sh — cyber-terminal portfolio. React 19 + Vite SPA; npm run build runs the verify gate then emits dist/ for Cloudflare Pages.",
