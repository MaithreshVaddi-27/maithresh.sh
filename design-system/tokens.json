{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "maithresh.sh Liquid Glass Cyber-Terminal Design System",
  "version": "2.0.0",
  "color": {
    "base": {
      "bg": { "value": "#07090e", "type": "color", "description": "Deep cybernetic substrate" },
      "surface": { "value": "#0d1117", "type": "color", "description": "T1 background" },
      "surface-raised": { "value": "#111620", "type": "color", "description": "T2 elevated panel" },
      "surface-overlay": { "value": "#161c27", "type": "color", "description": "T3 modal overlay" },
      "line": { "value": "#1e293b", "type": "color", "description": "Subtle border line" },
      "line-bold": { "value": "#334155", "type": "color", "description": "Active border line" }
    },
    "text": {
      "primary": { "value": "#f8fafc", "type": "color", "description": "High-contrast headings and active values" },
      "secondary": { "value": "#94a3b8", "type": "color", "description": "Readable body prose" },
      "mute": { "value": "#64748b", "type": "color", "description": "Subtitles and metadata" },
      "dim": { "value": "#475569", "type": "color", "description": "Prompt prefixes and disabled states" }
    },
    "accent": {
      "cyan": { "value": "#38bdf8", "type": "color", "description": "Primary accent (terminal cyan)" },
      "cyan-bright": { "value": "#7dd3fc", "type": "color", "description": "Highlight and glow tint" },
      "green": { "value": "#10b981", "type": "color", "description": "Success and online indicator" },
      "amber": { "value": "#f59e0b", "type": "color", "description": "Warning and telemetry alert" },
      "red": { "value": "#ef4444", "type": "color", "description": "Error and test failure indicator" }
    },
    "glass": {
      "matrix": { "value": "13, 17, 23", "type": "color", "description": "RGB tuple for glassmorphism blending" },
      "rim": { "value": "rgba(255, 255, 255, 0.12)", "type": "color", "description": "Top specular rim light" },
      "rim-dim": { "value": "rgba(255, 255, 255, 0.05)", "type": "color", "description": "Base glass divider" }
    }
  },
  "elevation": {
    "tier-1": {
      "background": "rgba(13, 17, 23, 0.50)",
      "backdrop-blur": "20px",
      "saturate": "165%",
      "border": "1px solid rgba(255, 255, 255, 0.05)",
      "description": "Embedded content cards, receding tier"
    },
    "tier-2": {
      "background": "rgba(13, 17, 23, 0.62)",
      "backdrop-blur": "28px",
      "saturate": "180%",
      "border": "1px solid rgba(255, 255, 255, 0.05)",
      "description": "Standard interactive cards and workbench shells"
    },
    "tier-3": {
      "background": "rgba(13, 17, 23, 0.70)",
      "backdrop-blur": "40px",
      "saturate": "200%",
      "border": "1px solid rgba(255, 255, 255, 0.12)",
      "description": "Floating chrome, header dock, and command modal"
    }
  },
  "typography": {
    "display": { "fontFamily": "JetBrains Mono, ui-monospace, monospace", "fontWeight": "700" },
    "mono": { "fontFamily": "JetBrains Mono, ui-monospace, monospace", "fontWeight": "400" },
    "body": { "fontFamily": "Inter, sans-serif", "fontWeight": "400" }
  },
  "motion": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "tactile-press": "scale(0.97)",
    "duration-fast": "0.15s",
    "duration-normal": "0.25s",
    "duration-slow": "0.65s"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "pill": "9999px"
  }
}
