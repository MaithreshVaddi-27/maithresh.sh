{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Systems Monograph",
  "version": "3.3.0",
  "baseTheme": "@astryxdesign/theme-neutral",
  "color": {
    "surface": {
      "canvas": { "value": "#0b0d11", "role": "Primary obsidian page substrate" },
      "panel": { "value": "#11141b", "role": "Elevated workbench and specimen panel" },
      "card": { "value": "#141821", "role": "Interactive control and chip surface" },
      "muted": { "value": "#181d28", "role": "Inline code and muted fill" },
      "inset": { "value": "#0d1016", "role": "Pipeline stage and metric box" }
    },
    "text": {
      "primary": { "value": "#f4f2ed", "role": "Warm bone primary ink (>16:1 on canvas)" },
      "secondary": { "value": "#a1a8b5", "role": "Body secondary and subtitle (>7.5:1 on canvas)" },
      "muted": { "value": "#848d9c", "role": "Metadata keys and captions" },
      "accent": { "value": "#60a5fa", "role": "Cobalt Blue emphasis and metrics" }
    },
    "accent": {
      "primary": { "value": "#2563eb", "role": "Primary CTA fill (5.17:1 AA contrast with #ffffff)" },
      "onPrimary": { "value": "#ffffff", "role": "Text on primary Cobalt fill" },
      "highlight": { "value": "#60a5fa", "role": "Interactive focus, active stage, signal pulse" },
      "soft": { "value": "#93c5fd", "role": "Code highlights and hover links" }
    },
    "semantic": {
      "info": { "value": "#60a5fa" },
      "warning": { "value": "#fbbf24" },
      "error": { "value": "#ef4444" }
    },
    "border": {
      "hairline": { "value": "#202634", "role": "Default section and ledger rule" },
      "strong": { "value": "#334155", "role": "Hover and active divider" }
    },
    "contributionRamp": ["#171c26", "#172554", "#1e40af", "#2563eb", "#60a5fa"]
  },
  "typography": {
    "display": {
      "family": "'Newsreader Variable', Georgia, serif",
      "opticalSizing": "auto",
      "weight": 400,
      "heroSize": "clamp(2.6rem, 5vw, 4.1rem)",
      "sectionSize": "clamp(2rem, 3.4vw, 2.75rem)",
      "tracking": "-0.025em"
    },
    "body": {
      "family": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
      "size": "15px–16px",
      "measure": "58ch–78ch",
      "lineHeight": 1.72
    },
    "mono": {
      "family": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace",
      "numericVariant": "tabular-nums"
    }
  },
  "radii": {
    "inner": "6px",
    "element": "8px",
    "container": "12px",
    "pill": "999px"
  },
  "brandMark": {
    "name": "Verified Monolith",
    "master": "assets/brand/maithresh-mark.svg",
    "smallCut": "assets/brand/maithresh-mark-kit/favicon-master.svg",
    "heroPortrait": "assets/illustrations/terminal-portrait.svg",
    "projectIconTile": {
      "background": "#11141b",
      "border": "#202634",
      "primaryStroke": "#f4f2ed",
      "secondaryStroke": "#a1a8b5",
      "accentStroke": "#60a5fa"
    },
    "colors": {
      "chevron": "#f4f2ed",
      "pillar": "#60a5fa",
      "tile": "#0b0d11"
    }
  },
  "motion": {
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durations": {
      "snap": "160ms",
      "panel": "260ms",
      "trace": "420ms",
      "signalDraw": "620ms"
    },
    "stageStaggerMs": 110,
    "reducedMotionPolicy": "Disable spatial transforms and stagger delays; retain 150ms opacity and color state changes."
  }
}
